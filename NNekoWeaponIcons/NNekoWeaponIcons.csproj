<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Name>NNekoWeaponIcons</Name>
        <Author>NaughtyNeko</Author>
        <Punchline></Punchline>
        <Description>

        </Description>
        <Tags>NNeko,NaughtyNeko,Triggers,RP,Conditional,Commands,Utility,Other</Tags>
        <WarningLevel>4</WarningLevel>
        <PackageLicenseExpression>APGL-3.0-or-later</PackageLicenseExpression>
        <Deterministic>true</Deterministic>
        <CopyLocalLockfileAssemblies>true</CopyLocalLockfileAssemblies>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>$(NoWarn);IDE1006,CS8618,MSB3270</NoWarn>
        <DalamudUseLocalPluginJson>true</DalamudUseLocalPluginJson>
        <Version>0.0.1.2</Version>
        <AssemblyVersion>0.0.1.2</AssemblyVersion>
        <FileVersion>0.0.1.2</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="NNekoWeaponIcons.json" CopyToOutputDirectory="Always" />
        <Content Include="Data\NNeko.png" CopyToOutputDirectory="Always" />
        <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2" />
    </ItemGroup>
</Project>